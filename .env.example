# --- Database (Neon / Postgres) ---------------------------------------------
# Vercel の Storage → Neon を接続すると DATABASE_URL が自動で設定されます。
# ローカルでは Neon の接続文字列（dev 用ブランチ推奨）か、手元の Postgres を指定してください。
#   例: postgres://user:pass@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#   例（ローカル Docker）: postgres://postgres:postgres@localhost:5432/postgres
# サーバーレスでは「Pooled connection」（ホスト名に -pooler が付く方）を使ってください。
# テーブルは初回アクセス時に自動作成されます。
DATABASE_URL=

# --- 画像ストレージ (Vercel Blob) ------------------------------------------
# Vercel の Storage で Blob ストアを作成してプロジェクトに接続すると自動で設定されます。
# 未設定の場合は ./data/uploads に保存します（開発用）。Vercel では必須です。
BLOB_READ_WRITE_TOKEN=
