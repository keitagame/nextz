# --- Database (Neon / Postgres) ---------------------------------------------
# Vercel の Storage → Neon を接続すると DATABASE_URL が自動で設定されます。
# ローカルでは Neon の接続文字列（dev 用ブランチ推奨）か、手元の Postgres を指定してください。
#   例: postgres://user:pass@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#   例（ローカル Docker）: postgres://postgres:postgres@localhost:5432/postgres
# サーバーレスでは「Pooled connection」（ホスト名に -pooler が付く方）を使ってください。
# テーブルは初回アクセス時に自動作成されます。
DATABASE_URL=

# --- 画像ストレージ (Vercel Blob) ------------------------------------------
# Vercel の Storage で Blob ストアを作成してプロジェクトに接続すると自動で設定されます。
# 未設定の場合は ./data/uploads に保存します（開発用）。Vercel では必須です。
BLOB_READ_WRITE_TOKEN=

# --- 管理者アカウント -------------------------------------------------------
# カンマ区切りのユーザー名。ここに書いたアカウントは /admin から他のユーザーを凍結（BAN）・解除できます。
# ユーザー名は先着順で登録されるため、管理者にするアカウントは公開前に自分で作成しておいてください。
#   例: ADMIN_USERNAMES=alice,bob
ADMIN_USERNAMES=

# --- アプリの公開 URL ------------------------------------------------------
# メール内のリンクと OAuth のリダイレクト URI に使います。本番では必ず設定してください（末尾のスラッシュなし）。
#   例: APP_URL=https://z.example.com   ローカル: APP_URL=http://localhost:3000
APP_URL=https://nextz.online

# --- メール送信 (Resend) ---------------------------------------------------
# メール認証の確認メール・パスワード再設定メールに使います。未設定でも開発中はコンソールに出力されます（本番では必須）。
# MAIL_FROM は Resend で認証したドメインのアドレスにしてください。  例: Z <noreply@example.com>
RESEND_API_KEY=
MAIL_FROM=Z <noreply@nextz.online>

# --- OAuth（外部サービスでログイン）-----------------------------------------
# ID とシークレットの両方を設定したサービスだけ、ログイン画面にボタンが出ます。
# リダイレクト URI: {APP_URL}/api/auth/oauth/google/callback  /  {APP_URL}/api/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
